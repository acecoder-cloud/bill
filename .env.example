# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# The secret key (sb_secret_...) or legacy "service_role" key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Anthropic Console → API Keys. SERVER ONLY.
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Optional: public URL of the app, used in email links (defaults to the request's own address)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
